# Enable PHP for API routes
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Route API requests to api/index.php
    # Match /api/* but not /api/index.php (to avoid loops)
    RewriteCond %{REQUEST_URI} ^/linknest/api/
    RewriteCond %{REQUEST_URI} !^/linknest/api/index\.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]
    
    # Frontend routes - serve index.html for SPA
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/linknest/api
    RewriteRule . index.html [L]
</IfModule>

