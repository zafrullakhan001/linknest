# Enable directory access and file serving
# MultiViews maps /api/tiles/... onto tiles.php and 403s PATH_INFO with spaces.
Options -Indexes -MultiViews +FollowSymLinks

# Set default charset to UTF-8
AddDefaultCharset UTF-8

# Set proper MIME types for JavaScript modules - MUST be before rewrite rules
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .htm .php .css .js .json .txt .xml

    # JavaScript files
    AddType application/javascript .js
    AddType application/javascript .mjs
    
    # TypeScript files (for development/source maps) - set MIME type even if blocked
    AddType application/javascript .ts
    AddType application/javascript .tsx
    
    # JSON files
    AddType application/json .json
    
    # CSS files
    AddType text/css .css
    
    # HTML files
    AddType text/html .html .htm
</IfModule>

# Force MIME type for all JavaScript/TypeScript files
<FilesMatch "\.(js|mjs|ts|tsx)$">
    ForceType application/javascript
    Header set Content-Type "application/javascript; charset=utf-8"
</FilesMatch>

# Enable PHP for API routes
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Allow SSH/VNC gateway WebSocket proxy paths (handled in VirtualHost)
    RewriteCond %{REQUEST_URI} ^/_ln_sshgw/
    RewriteRule . - [L]
    RewriteCond %{REQUEST_URI} ^/_ln_vncgw/
    RewriteRule . - [L]

    # FIRST: Allow direct access to dist/ directory and its files (including assets)
    RewriteCond %{REQUEST_URI} ^/dist/
    RewriteRule . - [L]
    
    # Allow direct access to uploads/ directory
    RewriteCond %{REQUEST_URI} ^/uploads/
    RewriteRule . - [L]

    # XAMPP DBs store /linknest/uploads/... ; Docker serves the app at /
    RewriteRule ^(?:linknest|ArchLinks|ERP3)/uploads/(.*)$ /uploads/$1 [L]

    # Browser Launcher Pro integration (not bundled by Vite)
    RewriteCond %{REQUEST_URI} ^/land/
    RewriteRule . - [L]

    # Bookmark Sync / unpacked extension files
    RewriteCond %{REQUEST_URI} ^/extensions/
    RewriteRule . - [L]
    
    # SECOND: Serve static assets from dist/assets/ (rewrite /assets/ to /dist/assets/)
    # This must come BEFORE the dist/ rule to catch /assets/ requests
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L,T=application/javascript]
    
    # Also handle direct requests to /dist/assets/ (allow direct access)
    RewriteCond %{REQUEST_URI} ^/dist/assets/
    RewriteRule . - [L]

    # SSH SharedWorker (Vite public/ → dist/); avoid SPA HTML 404 for worker fetch
    RewriteCond %{REQUEST_URI} ssh-session-shared-worker\.js$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule (^|/)ssh-session-shared-worker\.js$ dist/ssh-session-shared-worker.js [L]

    # SSH session keeper helper page
    RewriteCond %{REQUEST_URI} ssh-session-keepalive\.html$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule (^|/)ssh-session-keepalive\.html$ dist/ssh-session-keepalive.html [L]

    # TinyMCE iframe host (Vite public/ → dist/)
    RewriteCond %{REQUEST_URI} tinymce-editor\.html$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule (^|/)tinymce-editor\.html$ dist/tinymce-editor.html [L]

    # TinyMCE self-hosted runtime (Vite public/tinymce → dist/tinymce)
    # Without this, /tinymce/*.js returns the HTML 404 page and TinyMCE fails to load.
    RewriteCond %{REQUEST_URI} /tinymce/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule (^|/)tinymce/(.*)$ dist/tinymce/$2 [L]
    
    # Route API requests to api/index.php
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteCond %{REQUEST_URI} !^/api/index\.php
    RewriteCond %{REQUEST_FILENAME} !-f
    # BCTLS escapes spaces/CTL in $1 so category names with spaces are not 403'd.
    RewriteRule ^api/(.*)$ api/index.php?path=$1 [BCTLS,L,QSA]

    # Recyclable short URLs: /s/{code} → s.php
    RewriteRule ^s/([A-Za-z0-9]+)$ s.php?code=$1 [L,QSA]
    
    # Redirect /index.tsx to dist/index.html (serve compiled version)
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteCond %{REQUEST_URI} ^/index\.tsx$
    RewriteRule ^index\.tsx$ /dist/index.html [L]
    
    # Block direct access to other source files in production (return 404)
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteCond %{REQUEST_URI} \.(tsx?|jsx?)$
    RewriteCond %{REQUEST_URI} !^/dist
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_URI} !^/assets
    RewriteCond %{REQUEST_URI} !^/land
    RewriteCond %{REQUEST_URI} !^/extensions
    RewriteCond %{REQUEST_URI} !^/tinymce
    RewriteCond %{REQUEST_URI} !^/index\.tsx$
    RewriteRule . - [R=404,L]
    
    # PRODUCTION MODE: If dist/index.html exists, always serve from dist/
    # Handle root path FIRST - serve dist/index.html
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^(.*)$ /dist/index.html [L]
    
    # Also handle empty request URI explicitly
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteCond %{REQUEST_URI} ^$
    RewriteRule ^(.*)$ /dist/index.html [L]
    
    # Serve built index via internal rewrite (no 301 — browsers cache permanent redirects)
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteCond %{REQUEST_URI} ^/index\.(html|tsx)$
    RewriteCond %{REQUEST_URI} !^/dist/
    RewriteRule ^index\.(html|tsx)$ dist/index.html [L]
    
    # Serve other static files from dist/ if they exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_URI} !^/dist
    RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ dist/$1 [L]
    
    # Production: Force serve dist/index.html for all other SPA routes
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_URI} !^/s/
    RewriteCond %{REQUEST_URI} !^/dist
    RewriteCond %{REQUEST_URI} !^/land/
    RewriteCond %{REQUEST_URI} !^/extensions/
    RewriteCond %{REQUEST_URI} !^/docs/
    RewriteCond %{REQUEST_URI} !^/_ln_sshgw/
    RewriteCond %{REQUEST_URI} !^/_ln_vncgw/
    RewriteCond %{REQUEST_URI} !/tinymce/
    RewriteCond %{REQUEST_URI} !tinymce-editor\.html$
    RewriteCond %{REQUEST_URI} !ssh-session-shared-worker\.js$
    RewriteCond %{REQUEST_URI} !ssh-session-keepalive\.html$
    RewriteCond %{REQUEST_URI} !^/?$
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . dist/index.html [L]
    
    # DEVELOPMENT MODE: Only serve root index.html if dist doesn't exist
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html !-f
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_URI} !^/s/
    RewriteRule . index.html [L]
</IfModule>

# DirectoryIndex: Prefer dist/index.html in production
<IfModule mod_dir.c>
    DirectoryIndex dist/index.html index.html
</IfModule>

# Prevent browsers / proxies from sticking on an old SPA shell after deploy.
<IfModule mod_headers.c>
    <FilesMatch "(?i)^(index\.html|BUILD_INFO\.json|sw-cache-first\.php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
